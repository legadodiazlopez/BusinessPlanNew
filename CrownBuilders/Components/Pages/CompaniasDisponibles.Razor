@page "/companias-disponibles"
@using CrownBuilders
@inject IJSRuntime JS
@inject NavigationManager Navigation

<style>
    :root { --navy: #0A192F; --gold: #C5A059; }
    .text-navy { color: var(--navy); }
    .btn-gold { background-color: var(--navy); color: white; border: 2px solid var(--gold); }
    .card-custom { border: 2px solid var(--gold); border-radius: 15px; }
    .star-gold { color: var(--gold); }
    
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.7);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
    }
</style>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-navy m-0">Compañías</h3>
            <small class="text-muted">Buscando ayudantes</small>
        </div>
        <button class="btn btn-sm btn-outline-secondary" @onclick="AbrirConfiguracion">
            <i class="oi oi-cog"></i> Config
        </button>
    </div>

    <div class="card p-3 mb-4 shadow-sm card-custom">
        <input type="text" class="form-control" placeholder="Buscar por ciudad o especialidad..." 
               @bind="textoBusqueda" @bind:event="oninput" />
    </div>

    <div class="row">
        @foreach (var c in CompaniasFiltradas)
        {
            <div class="col-md-6 mb-4">
                <div class="card shadow-sm h-100 card-custom">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <div style="width: 60px; height: 60px; background: #eee; border-radius: 50%; margin-right: 15px;"></div>
                            <div>
                                <h5 class="fw-bold text-navy m-0">@c.Nombre</h5>
                                <small class="text-muted">@c.Ciudad</small>
                            </div>
                        </div>
                        <div class="mb-3 small">
                            <div class="d-flex justify-content-between"><span>Puntualidad:</span> <span class="star-gold">@GenerarEstrellas(c.Puntualidad)</span></div>
                            <div class="d-flex justify-content-between"><span>Pagos a tiempo:</span> <span class="star-gold">@GenerarEstrellas(c.Pagos)</span></div>
                            <div class="d-flex justify-content-between"><span>Trato humano:</span> <span class="star-gold">@GenerarEstrellas(c.Trato)</span></div>
                        </div>
                        <p class="card-text small text-muted border-top pt-2">Especialidad: <strong>@c.Especialidad</strong></p>
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <span class="fw-bold text-navy fs-5">$@c.Pago.ToString("F2") / hr</span>
                            <button class="btn btn-gold btn-sm px-4" @onclick="() => ContactarCompania(c.Nombre)">Contactar</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@if (mostrarConfig)
{
    <div class="modal-overlay">
        <div class="card p-4 shadow" style="width: 90%; border-radius: 15px;">
            <h5 class="fw-bold text-navy mb-4">Configuración</h5>
            
            <div class="d-flex justify-content-between align-items-center mb-4">
                <span>Estado: @(estaDisponible ? "Disponible" : "Ocupado")</span>
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" checked="@estaDisponible" @onchange="CambiarEstado" />
                </div>
            </div>

            <button class="btn btn-gold w-100 mb-2" @onclick="EditarPerfil">Editar Perfil</button>
            <button class="btn btn-outline-primary w-100 mb-2" @onclick="CerrarSesion">Cerrar Sesión</button>
            <button class="btn btn-outline-danger w-100 mb-3" @onclick="EliminarCuenta">Eliminar Cuenta</button>
            <button class="btn btn-secondary w-100" @onclick="CerrarModal">Cerrar</button>
        </div>
    </div>
}

@code {
    private string textoBusqueda = "";
    private bool mostrarConfig = false;
    private bool estaDisponible = true; 

    private CrownBuilders.Trabajador trabajador = new CrownBuilders.Trabajador();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var trabajadores = await DatabaseHelper.ObtenerTrabajadoresAsync();
            if (trabajadores != null && trabajadores.Count > 0)
            {
                trabajador = trabajadores[0];
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error al inicializar trabajador: {ex.Message}");
        }
    }

    public class Compania 
    {
        public string Nombre { get; set; }
        public string Ciudad { get; set; }
        public string Especialidad { get; set; }
        public double Pago { get; set; }
        public int Puntualidad { get; set; }
        public int Pagos { get; set; }
        public int Trato { get; set; }
    }

    private List<Compania> listaCompanias = new List<Compania> 
    {
        new Compania { Nombre = "Builders NY", Ciudad = "Long Island", Especialidad = "Pisos", Pago = 40.00, Puntualidad = 5, Pagos = 5, Trato = 4 },
        new Compania { Nombre = "Wood Masters", Ciudad = "Catskills", Especialidad = "Madera", Pago = 42.50, Puntualidad = 4, Pagos = 5, Trato = 5 }
    };

    private List<Compania> CompaniasFiltradas => listaCompanias
        .Where(c => string.IsNullOrEmpty(textoBusqueda) || c.Ciudad.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase) || c.Especialidad.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase))
        .ToList();

    private string GenerarEstrellas(int c) => new string('★', c) + new string('☆', 5 - c);

    private void CambiarEstado(ChangeEventArgs e) 
    {
        estaDisponible = (bool)e.Value;
    }

    private void AbrirConfiguracion() => mostrarConfig = true;
    private void CerrarModal() => mostrarConfig = false;

    private void ContactarCompania(string nombre) => Navigation.NavigateTo("/mensajeria");
    private void EditarPerfil() => Navigation.NavigateTo("/editar-perfil");
    private void CerrarSesion() => Navigation.NavigateTo("/login-trabajador");

    private async Task EliminarCuenta()
    {
        bool confirmado = await JS.InvokeAsync<bool>("confirm", "¿Estás seguro de eliminar tu cuenta permanentemente?");
        if (confirmado)
        {
            try
            {
                // Purgamos base de datos SQLite
                await DatabaseHelper.PurgarTrabajadoresAsync();
                
                // Limpiamos variable local
                trabajador = new CrownBuilders.Trabajador();
                
                await JS.InvokeVoidAsync("alert", "Cuenta eliminada exitosamente.");
                
                // Redirección estricta a la pantalla principal de selección de perfiles (/), destruyendo el historial o caché anterior.
                Navigation.NavigateTo("/", forceLoad: true);
            }
            catch (Exception ex)
            {
                await JS.InvokeVoidAsync("alert", "Error al eliminar la cuenta: " + ex.Message);
            }
        }
    }
}