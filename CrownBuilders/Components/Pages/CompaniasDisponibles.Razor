@page "/companias-disponibles"
@using CrownBuilders
@using CrownBuilders.Services
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject ApiService ApiService
@inject MessagingService MessagingService

<div class="container mt-4 cb-page">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-navy m-0">Compañías</h3>
            <small class="text-muted">Buscando ayudantes</small>
        </div>
        <button class="btn btn-cb-secondary" @onclick="AbrirConfiguracion">
            <i class="oi oi-cog"></i> Config
        </button>
    </div>

    <div class="card p-3 mb-4 card-custom">
        <input type="text" class="form-control" placeholder="Buscar por ciudad o especialidad..." 
               @bind="textoBusqueda" @bind:event="oninput" />
    </div>

    @if (estaCargando)
    {
        <div class="text-center my-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando compañías...</span>
            </div>
            <p class="mt-2 text-muted small">Cargando directorio de compañías...</p>
        </div>
    }
    else if (!CompaniasFiltradas.Any())
    {
        <div class="cb-empty-state text-center my-5">
            <p class="text-muted mb-0">No se encontraron compañías con esa búsqueda.</p>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var c in CompaniasFiltradas)
            {
                <div class="col-md-6 mb-4" @key="c.Id">
                    <div class="card shadow-sm h-100 card-custom cb-directory-card">
                        <div class="card-body cb-directory-card__body">
                            <div class="d-flex align-items-center mb-3 cb-directory-card__identity">
                                <div class="cb-avatar d-flex align-items-center justify-content-center fw-bold text-navy me-3">
                                    @if (c.TieneFotoPerfil && !fotosFallidas.Contains(c.Id))
                                    {
                                        <img class="cb-directory-card__photo"
                                             src="@ObtenerRutaFoto(c.Id)"
                                             alt="Foto de @c.Nombre"
                                             loading="lazy"
                                             @onerror="() => MarcarFotoFallida(c.Id)" />
                                    }
                                    else
                                    {
                                        @(string.IsNullOrEmpty(c.Nombre) ? "C" : c.Nombre.Substring(0, 1).ToUpper())
                                    }
                                </div>
                                <div class="cb-directory-card__company">
                                    <h5 class="fw-bold text-navy m-0">@c.Nombre</h5>
                                    <small class="text-muted">@c.Ciudad</small>
                                </div>
                            </div>
                            @if (c.TotalResenas > 0)
                            {
                                <div class="cb-directory-card__ratings small" aria-label="Calificaciones de @c.TotalResenas reseñas">
                                    <div class="d-flex justify-content-between gap-2"><span>Puntualidad:</span><span class="cb-directory-card__stars" aria-label="@c.Puntualidad.ToString("F1") de 5">@GenerarEstrellas(c.Puntualidad)</span></div>
                                    <div class="d-flex justify-content-between gap-2"><span>Pagos a tiempo:</span><span class="cb-directory-card__stars" aria-label="@c.Pagos.ToString("F1") de 5">@GenerarEstrellas(c.Pagos)</span></div>
                                    <div class="d-flex justify-content-between gap-2"><span>Trato humano:</span><span class="cb-directory-card__stars" aria-label="@c.Trato.ToString("F1") de 5">@GenerarEstrellas(c.Trato)</span></div>
                                </div>
                            }
                            else
                            {
                                <p class="cb-directory-card__ratings small text-muted mb-0">Sin reseñas todavía</p>
                            }
                            <p class="card-text small text-muted border-top pt-2 mb-1 cb-directory-card__specialty">Especialidad: <strong>@c.Especialidad</strong></p>

                            <div class="d-flex justify-content-between align-items-center mt-3 border-top pt-3 cb-directory-card__footer">
                                <span class="fw-bold text-navy cb-directory-card__price">$@c.MontoPago.ToString("F2") @ObtenerEtiquetaFormaPago(c.FormaPago)</span>
                                <button class="btn btn-gold px-4 cb-directory-card__contact" @onclick="() => ContactarCompania(c)">Contactar</button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@if (mostrarConfig)
{
    <div class="cb-modal-overlay">
        <div class="card cb-modal-card p-4 shadow">
            <h5 class="fw-bold text-navy mb-4">Configuración</h5>
            
            <div class="d-flex justify-content-between align-items-center mb-4">
                <span>Estado: @(estaDisponible ? "Disponible" : "Ocupado")</span>
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" checked="@estaDisponible" @onchange="CambiarEstado" />
                </div>
            </div>

            <button class="btn btn-gold w-100 mb-2" @onclick="EditarPerfil">Editar Perfil</button>
            <button class="btn btn-outline-primary w-100 mb-2" @onclick="CerrarSesion">Cerrar Sesión</button>
            <button class="btn btn-outline-danger w-100 mb-3" @onclick="EliminarCuenta">Eliminar Cuenta</button>
            <button class="btn btn-secondary w-100" @onclick="CerrarModal">Cerrar</button>
        </div>
    </div>
}

@code {
    private string textoBusqueda = "";
    private bool mostrarConfig = false;
    private bool estaDisponible = true;
    private bool estaCargando = true;
    private readonly HashSet<int> fotosFallidas = new();

    private CrownBuilders.Trabajador trabajador = new CrownBuilders.Trabajador();
    private List<Compania> listaCompanias = new List<Compania>();
    
    protected override void OnInitialized()
    {
        // Ejecutar sin bloquear el ciclo de vida de Blazor.
        _ = CargarDatosDinamicosAsync();
    }

    private async Task CargarDatosDinamicosAsync()
    {
        Task<List<Compania>?> companiasRemotasTask = Task.FromResult<List<Compania>?>(null);

        try
        {
            // FASE 1: mostrar caché local mientras la actualización remota avanza en paralelo.
            var trabajadoresTask = DatabaseHelper.ObtenerTrabajadoresAsync();
            var companiasLocalesTask = DatabaseHelper.ObtenerCompaniasLocalesAsync();
            companiasRemotasTask = DatabaseHelper.ActualizarCompaniasDesdeApiAsync();

            var resultadoLocal = await companiasLocalesTask;
            if (resultadoLocal.Any())
            {
                listaCompanias = resultadoLocal;
                estaCargando = false;
                await InvokeAsync(StateHasChanged);
            }

            var trabajadores = await trabajadoresTask;
            if (trabajadores != null && trabajadores.Count > 0)
            {
                trabajador = trabajadores[0];
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"[CARGA LOCAL] Error: {ex.Message}");
        }

        try
        {
            // FASE 2: aplicar una única respuesta remota ya sincronizada con SQLite.
            var resultadoRemoto = await companiasRemotasTask;
            if (resultadoRemoto != null)
            {
                listaCompanias = resultadoRemoto;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"[ACTUALIZACIÓN REMOTA] Error: {ex.Message}");
        }
        finally
        {
            estaCargando = false;
            await InvokeAsync(StateHasChanged); // Actualiza la pantalla final para el usuario
        }
    }

    public class Compania
    {
        public int Id { get; set; }
        public string Nombre { get; set; } = string.Empty;
        public string Ciudad { get; set; } = string.Empty;
        public string Especialidad { get; set; } = string.Empty;
        public string FormaPago { get; set; } = string.Empty;
        public double MontoPago { get; set; }
        public bool TieneFotoPerfil { get; set; }
        public int TotalResenas { get; set; }
        public double Puntualidad { get; set; }
        public double Pagos { get; set; }
        public double Trato { get; set; }
    }

    private IEnumerable<Compania> CompaniasFiltradas => listaCompanias
        .Where(c => string.IsNullOrEmpty(textoBusqueda) || 
                    c.Ciudad.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase) || 
                    c.Especialidad.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase));

    private void CambiarEstado(ChangeEventArgs e) 
    {
        if (e.Value is bool val) estaDisponible = val;
    }

    private void AbrirConfiguracion() => mostrarConfig = true;
    private void CerrarModal() => mostrarConfig = false;

    public static Compania MapearCompania(CrownBuilders.Models.Compania compania)
    {
        ArgumentNullException.ThrowIfNull(compania);

        return new Compania
        {
            Id = compania.Id,
            Nombre = compania.NombreEmpresa ?? string.Empty,
            Ciudad = compania.Ciudad ?? string.Empty,
            Especialidad = compania.Especialidad ?? string.Empty,
            FormaPago = compania.FormaPago ?? string.Empty,
            MontoPago = (double)compania.MontoPago,
            TieneFotoPerfil = !string.IsNullOrWhiteSpace(compania.FotoPerfil)
        };
    }

    private static string ObtenerRutaFoto(int id) => $"{ApiEndpoints.ApiBaseUrl}Perfil/foto-compania/{id}";

    private void MarcarFotoFallida(int id) => fotosFallidas.Add(id);

    private static string GenerarEstrellas(double calificacion)
    {
        var llenas = (int)Math.Round(Math.Clamp(calificacion, 0, 5), MidpointRounding.AwayFromZero);
        return new string('★', llenas) + new string('☆', 5 - llenas);
    }

    public static string ObtenerEtiquetaFormaPago(string? formaPago) =>
        formaPago?.Trim().ToLowerInvariant() switch
        {
            "porhora" => "/ hora",
            "porjornada" => "/ jornada",
            _ => "/ jornada"
        };

    public static string ConstruirRutaMensajeria(Compania compania)
    {
        ArgumentNullException.ThrowIfNull(compania);

        return string.IsNullOrWhiteSpace(compania.Nombre)
            ? $"/mensajeria-trabajador/compania/{compania.Id}"
            : $"/mensajeria-trabajador/{Uri.EscapeDataString(compania.Nombre)}/{compania.Id}";
    }

    private void ContactarCompania(Compania compania) => Navigation.NavigateTo(ConstruirRutaMensajeria(compania));

    private void EditarPerfil() => Navigation.NavigateTo("/editar-perfil");
    private async Task CerrarSesion()
    {
        try
        {
            await MessagingService.StopAsync();
        }
        catch (Exception exception)
        {
            System.Diagnostics.Debug.WriteLine($"[AUTH] No se pudo cerrar el chat durante el cierre de sesión: {exception.Message}");
        }
        finally
        {
            await ApiService.SetAuthTokenAsync(null);
            Navigation.NavigateTo("/login-trabajador");
        }
    }

    private async Task EliminarCuenta()
    {
        bool confirmado = await JS.InvokeAsync<bool>("confirm", "¿Estás seguro de eliminar tu cuenta permanentemente?");
        if (confirmado)
        {
            try
            {
                await DatabaseHelper.PurgarTrabajadoresAsync();
                trabajador = new CrownBuilders.Trabajador();
                await JS.InvokeVoidAsync("alert", "Cuenta eliminada exitosamente.");
                Navigation.NavigateTo("/", forceLoad: true);
            }
            catch (Exception ex)
            {
                await JS.InvokeVoidAsync("alert", "Error al eliminar la cuenta: " + ex.Message);
            }
        }
    }
}
