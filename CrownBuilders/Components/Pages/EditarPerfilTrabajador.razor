@page "/editar-perfil"
@using CrownBuilders
@inject NavigationManager Navigation
@inject IJSRuntime JS

<style>
    :root { --navy: #0A192F; --gold: #C5A059; }
    .card-custom { border: 2px solid var(--gold); border-radius: 15px; }
    .btn-gold { background-color: var(--navy); color: white; border: 2px solid var(--gold); }
</style>

<div class="container mt-4 mb-5">
    <h3 class="fw-bold text-navy mb-4">Editar Perfil</h3>

    <div class="card p-4 shadow-sm card-custom">
        <div class="text-center mb-4">
            <div class="position-relative d-inline-block" style="width: 130px; height: 130px;">
                <label for="fotoUpload" class="d-block w-100 h-100 rounded-circle overflow-hidden border border-4 shadow-sm" style="border-color: #C5A059 !important; cursor: pointer; background-color: #f8f9fa; display: flex; align-items: center; justify-content: center;">
                    @if (!string.IsNullOrEmpty(trabajador.FotoPerfil) && trabajador.FotoPerfil != "default")
                    {
                        <img src="@trabajador.FotoPerfil" style="width: 100%; height: 100%; object-fit: cover;" />
                    }
                    else
                    {
                        <span class="text-muted small" style="font-size: 0.85em; text-align: center; color: #C5A059; font-weight: bold;">Cambiar Foto</span>
                    }
                </label>
                <InputFile id="fotoUpload" OnChange="HandleFotoUpload" class="d-none" />
            </div>
            <br />
            <small class="text-muted">Presiona el círculo para cambiar</small>
        </div>

        <div class="mb-3">
            <label class="form-label">Nombre Completo</label>
            <input type="text" class="form-control" @bind="trabajador.Nombre" />
        </div>
        <div class="mb-3">
            <label class="form-label">Ciudad (Town)</label>
            <input type="text" class="form-control" @bind="trabajador.Ciudad" />
        </div>
        <div class="mb-3">
            <label class="form-label">experiencia</label>
            <input type="number" class="form-control" @bind="trabajador.Experiencia" />
        </div>
        <div class="mb-3">
            <label class="form-label">Correo Electrónico</label>
            <input type="email" class="form-control" @bind="trabajador.Correo" />
        </div>
        <div class="mb-3">
            <label class="form-label">Teléfono</label>
            <input type="tel" class="form-control" @bind="trabajador.Telefono" />
        </div>
         <div class="mb-3">
            <label class="form-label">Salario</label>
            <input type="tel" class="form-control" @bind="trabajador.Salario" />
        </div>
        <div class="mb-3">
            <label class="form-label">Nueva Contraseña</label>
            <input type="password" class="form-control" @bind="trabajador.Password" />
        </div>

        <div class="mb-3">
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" @bind="trabajador.TieneVehiculo" />
                <label class="form-check-label">¿Cuenta con vehículo propio?</label>
            </div>
            <div class="form-check form-switch mt-2">
                <input class="form-check-input" type="checkbox" @bind="trabajador.TieneHerramientas" />
                <label class="form-check-label">¿Cuenta con herramientas propias?</label>
            </div>
        </div>

        <button class="btn btn-gold w-100 fw-bold mt-3" @onclick="GuardarDatos">Guardar Cambios</button>
        <button class="btn btn-outline-secondary w-100 mt-2" @onclick="Cancelar">Cancelar</button>
    </div>
</div>

@code {
    private Trabajador trabajador = new Trabajador();

    protected override async Task OnInitializedAsync()
    {
        try 
        {
            var lista = await DatabaseHelper.ObtenerTrabajadoresAsync();
            if (lista != null && lista.Count > 0)
            {
                trabajador = lista[0];
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error al cargar perfil: {ex.Message}");
        }
    }

    private async Task HandleFotoUpload(InputFileChangeEventArgs e)
    {
        try 
        {
            var file = e.File;
            var format = "image/png";
            var resizedImage = await file.RequestImageFileAsync(format, 400, 400); 
            var buffer = new byte[resizedImage.Size];
            
            await resizedImage.OpenReadStream(maxAllowedSize: 5120000).ReadAsync(buffer);
            
            trabajador.FotoPerfil = $"data:{format};base64,{Convert.ToBase64String(buffer)}";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al procesar la imagen: {ex.Message}");
        }
    }

    private async Task GuardarDatos()
    {
        try {
            await DatabaseHelper.ActualizarTrabajadorAsync(trabajador);
            await JS.InvokeVoidAsync("alert", "Perfil actualizado correctamente.");
            Navigation.NavigateTo("/companias-disponibles");
        } catch (Exception) {
            await JS.InvokeVoidAsync("alert", "Error al guardar los cambios.");
        }
    }

    private void Cancelar() => Navigation.NavigateTo("/companias-disponibles");
}