@page "/mensajeria-trabajador"
@page "/mensajeria-trabajador/{NombreCompaniaRoute}"
@page "/mensajeria-trabajador/{NombreCompaniaRoute}/{CompaniaIdRoute}"
@page "/mensajeria-trabajador/compania/{CompaniaIdRoute}"
@using Microsoft.Extensions.Logging
@using System.Net.Http.Json
@implements IAsyncDisposable
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ILogger<Mensajeriatrabajor> Logger
@inject CrownBuilders.Services.ApiService ApiService
@inject CrownBuilders.Services.MessagingService MessagingService

<div class="container-fluid d-flex flex-column" style="height: 100vh; background-color: #f8f9fa;">
    <!-- ENCABEZADO CON BOTONES DE VOLVER, RESEÑA Y REPORTAR UNIFICADOS -->
    <div class="bg-white p-3 shadow-sm d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center">
            <button class="btn btn-sm btn-link text-dark p-0 me-2" @onclick="Volver" style="text-decoration: none;">← Volver</button>
            <h5 class="fw-bold mb-0 ms-2" style="color: #0A1128;">Chat con @nombreCompania</h5>
        </div>
        <div class="d-flex align-items-center gap-2">
            <!-- Diseño profesional y discreto para "Próximamente" -->
            <div class="bg-light text-secondary px-2 py-1" style="font-size: 0.65rem; border: 1px solid #dee2e6; border-radius: 12px; opacity: 0.8; user-select: none;">
                ⭐ Reseñas <span class="fst-italic">Próximamente</span>
            </div>
            <!-- Botón de reportar más visible -->
            <button class="btn btn-sm btn-danger fw-bold px-3 shadow-sm" style="font-size: 0.8rem; border-radius: 12px;" @onclick="ReportarCuenta">
                Reportar
            </button>
        </div>
    </div>

    <!-- ÁREA DE MENSAJES -->
    <div class="flex-grow-1 p-3 overflow-auto">
        @foreach (var msg in messages)
        {
            <div class="d-flex mb-3 @(msg.EsMio ? "justify-content-end" : "justify-content-start")">
                <div class="p-2 px-3 shadow-sm @(msg.EsMio ? "bg-warning text-dark" : "bg-white text-dark")" style="border-radius: 15px; max-width: 80%;">
                    <span class="fw-bold d-block mb-1" style="font-size: 0.75rem; opacity: 0.8;">
                        @(msg.EsMio ? "Tú" : msg.Remitente)
                    </span>
                    <p class="mb-0 small">@msg.Texto</p>
                </div>
            </div>
        }
    </div>

    <!-- ENTRADA DE TEXTO -->
    <div class="bg-white p-3 shadow-lg">
        <div class="small text-muted mb-2">
            Estado: @(chatConectado ? "Conectado en tiempo real" : estadoChat)
        </div>
        <div class="input-group">
            <input type="text" class="form-control" placeholder="Escribe un mensaje..." @bind="mensajeNuevo" @bind:event="oninput" @onkeyup="HandleKeyUp" />
            <button class="btn text-white fw-bold" style="background-color: #D4AF37;" disabled="@(!chatConectado)" @onclick="EnviarMensaje">Enviar</button>
        </div>
    </div>
</div>

<!-- MODAL DE RESEÑA DIRECTA -->
@if (mostrarModalResena)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" style="color: #0A1128;">Calificar a @nombreCompania</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModalResena"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Puntualidad</label>
                        <select class="form-select" @bind="puntajePuntualidad">
                            <option value="5">⭐⭐⭐⭐⭐ (5) Excelente</option>
                            <option value="4">⭐⭐⭐⭐ (4) Bueno</option>
                            <option value="3">⭐⭐⭐ (3) Regular</option>
                            <option value="2">⭐⭐ (2) Malo</option>
                            <option value="1">⭐ (1) Pésimo</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Pagos a tiempo</label>
                        <select class="form-select" @bind="puntajePagos">
                            <option value="5">⭐⭐⭐⭐⭐ (5) Excelente</option>
                            <option value="4">⭐⭐⭐⭐ (4) Bueno</option>
                            <option value="3">⭐⭐⭐ (3) Regular</option>
                            <option value="2">⭐⭐ (2) Malo</option>
                            <option value="1">⭐ (1) Pésimo</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Trato humano</label>
                        <select class="form-select" @bind="puntajeTrato">
                            <option value="5">⭐⭐⭐⭐⭐ (5) Excelente</option>
                            <option value="4">⭐⭐⭐⭐ (4) Bueno</option>
                            <option value="3">⭐⭐⭐ (3) Regular</option>
                            <option value="2">⭐⭐ (2) Malo</option>
                            <option value="1">⭐ (1) Pésimo</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-secondary" @onclick="CerrarModalResena">Cancelar</button>
                    <button class="btn text-white fw-bold" style="background-color: #D4AF37;" @onclick="EnviarResena">Enviar Calificación</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string? NombreCompaniaRoute { get; set; }
    [Parameter] public string? CompaniaIdRoute { get; set; }
    private List<MensajeUI> messages = new List<MensajeUI>();
    private string? mensajeNuevo;
    
    private string nombreCompania = "Compañía";

    // Variables para Reseña
    private bool mostrarModalResena = false;
    private int puntajePuntualidad = 5;
    private int puntajePagos = 5;
    private int puntajeTrato = 5;
    private string? comentarioResena;
    private int trabajadorIdActual;
    private int companiaIdSimulada;
    private int conversationId;
    private bool chatConectado;
    private bool chatInicioIntentado;
    private string estadoChat = "Conectando...";

    // Cliente estático para reseñas (evita agotar sockets como en la compañía)
    private static readonly HttpClient _httpClientResenas = new HttpClient(new HttpClientHandler
    {
        ServerCertificateCustomValidationCallback = (message, cert, chain, errors) => true
    })
    {
        // Producción/Azure: https://crownbuilders-portal-drbqbfbphpe7hude.centralus-01.azurewebsites.net/api/
        // Desarrollo local:
        BaseAddress = new Uri(ApiEndpoints.ApiBaseUrl),
        Timeout = TimeSpan.FromSeconds(30)
    };

    public class MensajeUI
    {
        public string ClientMessageId { get; set; } = "";
        public string Remitente { get; set; } = "";
        public string Texto { get; set; } = "";
        public bool EsMio { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        messages.Clear();
        await ApiService.RestoreAuthTokenAsync();

        trabajadorIdActual = ApiService.AuthenticatedUserId ?? 0;
        System.Diagnostics.Debug.WriteLine(
            $"[CHAT] ID de trabajador autenticado: {trabajadorIdActual}");

        if (!string.IsNullOrEmpty(NombreCompaniaRoute))
        {
            nombreCompania = Uri.UnescapeDataString(NombreCompaniaRoute);
        }

        if (!string.IsNullOrEmpty(CompaniaIdRoute) && int.TryParse(CompaniaIdRoute, out int companiaIdFromRoute))
        {
            companiaIdSimulada = companiaIdFromRoute;
        }

        if (string.IsNullOrWhiteSpace(NombreCompaniaRoute) && companiaIdSimulada > 0)
        {
            try
            {
                var compania = await DatabaseHelper.ObtenerCompaniaPorIdAsync(companiaIdSimulada);
                if (!string.IsNullOrWhiteSpace(compania?.NombreEmpresa))
                {
                    nombreCompania = compania.NombreEmpresa;
                }
            }
            catch (Exception ex)
            {
                Logger.LogDebug(ex, "No se pudo recuperar el nombre de la compañía para la conversación.");
            }
        }

        if (trabajadorIdActual <= 0 || companiaIdSimulada <= 0)
        {
            messages.Add(new MensajeUI
            {
                Remitente = "Sistema",
                Texto = "No se pudo identificar a los participantes de esta conversación.",
                EsMio = false
            });
            return;
        }

        try
        {
            var conversation = await ApiService.EnsureConversationAsync(
                trabajadorIdActual,
                companiaIdSimulada);
            conversationId = conversation?.Id ?? 0;
            System.Diagnostics.Debug.WriteLine($"[CHAT] Conversación trabajador preparada: {conversationId}");
            if (conversationId > 0)
            {
                MessagingService.MessageReceived += OnMessageReceivedAsync;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "No se pudo preparar la conversación de mensajería.");
        }

        if (conversationId <= 0)
        {
            estadoChat = "No se pudo validar la sesión. Inicia sesión nuevamente.";
        }

        try
        {
            System.Diagnostics.Debug.WriteLine($"[MENSAJERÍA] Cargando historial: TrabajadorID={trabajadorIdActual}, CompaniaID={companiaIdSimulada}");
            
            // Mismo orden que en compañía: primero base local para carga inmediata
            var historialDB = await DatabaseHelper.ObtenerHistorialAsync(trabajadorIdActual, companiaIdSimulada);
            System.Diagnostics.Debug.WriteLine($"[MENSAJERÍA] Mensajes obtenidos: {historialDB?.Count ?? 0}");
            
            if (historialDB != null)
            {
                foreach (var msj in historialDB)
                {
                    bool esMio = string.Equals(msj.Remitente, "trabajador", StringComparison.OrdinalIgnoreCase) ||
                                string.Equals(msj.Remitente, "tú", StringComparison.OrdinalIgnoreCase);

                    string remitenteNombre = esMio ? "Tú" : (string.IsNullOrWhiteSpace(msj.Remitente) ? nombreCompania : msj.Remitente);

                    messages.Add(new MensajeUI
                    {
                        ClientMessageId = msj.ClientMessageId,
                        Remitente = remitenteNombre,
                        Texto = msj.Texto ?? "",
                        EsMio = esMio
                    });
                }
                System.Diagnostics.Debug.WriteLine($"[MENSAJERÍA] Historial cargado con {messages.Count} mensajes");
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"[MENSAJERÍA] Error cargando historial: {ex.Message}");
            messages.Add(new MensajeUI { Remitente = "Sistema", Texto = "Modo sin conexión cargado.", EsMio = false });
        }


    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (conversationId > 0 && !chatInicioIntentado)
        {
            try
            {
                chatInicioIntentado = true;
                System.Diagnostics.Debug.WriteLine($"[CHAT] Iniciando SignalR trabajador para conversación {conversationId}");
                using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(15));
                await MessagingService.StartAsync(conversationId, cts.Token);
                chatConectado = true;
                estadoChat = "Conectado en tiempo real";
                System.Diagnostics.Debug.WriteLine("[CHAT] SignalR trabajador conectado");
            }
            catch (Exception ex)
            {
                chatConectado = false;
                estadoChat = "No se pudo conectar. Inicia sesión nuevamente.";
                Logger.LogWarning(ex, "No se pudo conectar al servidor de mensajería.");
            }

            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OnMessageReceivedAsync(MensajeApiResponse message)
    {
        System.Diagnostics.Debug.WriteLine(
            $"[CHAT] Mensaje recibido por trabajador: {message.ClientMessageId}");

        try
        {
            await DatabaseHelper.GuardarMensajeRemotoAsync(message).ConfigureAwait(false);
        }
        catch (Exception exception)
        {
            Logger.LogWarning(
                exception,
                "No se pudo guardar el mensaje remoto en la caché local del trabajador.");
        }

        await InvokeAsync(() =>
        {
            if (messages.Any(item => item.ClientMessageId == message.ClientMessageId))
            {
                return;
            }

            var esMio = string.Equals(message.Sender, "trabajador", StringComparison.OrdinalIgnoreCase);
            messages.Add(new MensajeUI
            {
                ClientMessageId = message.ClientMessageId,
                Remitente = esMio ? "Tú" : (string.IsNullOrWhiteSpace(message.Sender) ? nombreCompania : message.Sender),
                Texto = message.Text,
                EsMio = esMio
            });
            StateHasChanged();
        });
    }
    
    private void Volver() => Navigation.NavigateTo("/companias-disponibles");

    private void DejarResena() => mostrarModalResena = true;
    private void CerrarModalResena() => mostrarModalResena = false;

    private async Task EnviarResena()
    {
        try
        {
            var resena = new
            {
                EmisorId = trabajadorIdActual,
                ReceptorId = companiaIdSimulada,
                TipoReceptor = "Compania",
                Calificacion1 = puntajePuntualidad,
                Calificacion2 = puntajePagos,
                Calificacion3 = puntajeTrato,
                Comentario = comentarioResena ?? ""
            };

            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(25));
            var response = await _httpClientResenas.PostAsJsonAsync("resenas", resena, cts.Token);

            if (response.IsSuccessStatusCode)
            {
                await JS.InvokeVoidAsync("alert", $"Has calificado a {nombreCompania} exitosamente.");
                mostrarModalResena = false;
            }
            else
            {
                await JS.InvokeVoidAsync("alert", $"Error al guardar la reseña. Código: {response.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Error: {ex.Message}");
        }
    }

    private async Task ReportarCuenta()
    {
        string numeroWhatsApp = "16314860524";
        string mensaje = Uri.EscapeDataString($"Hola soporte, necesito reportar un inconveniente con la compañía {nombreCompania} a través de la app Crown Builders.");
        string url = $"https://wa.me/{numeroWhatsApp}?text={mensaje}";
        await JS.InvokeVoidAsync("open", url, "_blank");
    }
    
    private async Task EnviarMensaje()
    {
        if (!chatConectado || string.IsNullOrWhiteSpace(mensajeNuevo))
        {
            return;
        }

        if (!string.IsNullOrWhiteSpace(mensajeNuevo))
        {
            var textoAEnviar = mensajeNuevo;
            mensajeNuevo = string.Empty;
            var clientMessageId = Guid.NewGuid().ToString("D");
            var envioRemotoConfirmado = false;

            try
            {
                var msjEnviado = new CrownBuilders.Models.Mensaje
                {
                    ClientMessageId = clientMessageId,
                    ConversacionId = conversationId,
                    TrabajadorId = trabajadorIdActual,
                    CompaniaId = companiaIdSimulada,
                    Remitente = "trabajador",
                    Texto = textoAEnviar,
                    FechaEnvio = DateTime.UtcNow
                };
                await DatabaseHelper.EncolarMensajeAsync(msjEnviado).ConfigureAwait(false);

                if (conversationId > 0)
                {
                    var response = await MessagingService.SendAsync(
                        conversationId,
                        Guid.Parse(clientMessageId),
                        textoAEnviar).ConfigureAwait(false);
                    envioRemotoConfirmado = true;
                    await DatabaseHelper.MarcarMensajeSincronizadoAsync(
                        clientMessageId,
                        response.Id,
                        response.ConversationId).ConfigureAwait(false);
                }
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine(
                    $"[CHAT] Error en envío de trabajador: {ex.GetType().Name}: {ex.Message}");
                Logger?.LogError($"[CHAT] Error guardando mensaje localmente: {ex.Message}");
            }

            if (envioRemotoConfirmado)
            {
                await InvokeAsync(() =>
                {
                    if (messages.Any(item => item.ClientMessageId == clientMessageId))
                    {
                        return;
                    }

                    messages.Add(new MensajeUI
                    {
                        ClientMessageId = clientMessageId,
                        Remitente = "Tú",
                        Texto = textoAEnviar,
                        EsMio = true
                    });
                    StateHasChanged();
                });
            }
        }
    }

    private async Task HandleKeyUp(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await EnviarMensaje();
        }
    }

    public async ValueTask DisposeAsync()
    {
        MessagingService.MessageReceived -= OnMessageReceivedAsync;
        await Task.CompletedTask;
    }
}
