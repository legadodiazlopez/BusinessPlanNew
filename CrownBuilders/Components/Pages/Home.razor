@page "/"
@inject NavigationManager Navigation

<div class="container mt-3 px-3 cb-page cb-page-narrow">
    <div class="text-center py-4 px-3 mb-4 cb-page-header">
        <h1 class="fw-bold text-gold mb-2">Crown Builders</h1>
        <p class="fst-italic">"Conectando el empleo con la oportunidad"</p>
    </div>

   <h4 class="text-center fw-bold text-navy mb-4">¿Cómo deseas continuar hoy?</h4>

<div class="row g-3">
    <!-- Opción Trabajador -->
    <div class="col-12">
        <div class="card card-custom h-100 p-3">
            <div class="card-body text-center">
                <h5 class="fw-bold text-navy mb-2">Soy Trabajador</h5>
                <p class="text-muted small mb-4">Acceso a proyectos y oportunidades locales.</p>
                <button @onclick="IrATrabajadorLogin" class="btn btn-gold w-100 py-2 fw-bold">
                    Ingresar a mi perfil
                </button>
            </div>
        </div>
    </div>

    <!-- Opción Compañía -->
    <div class="col-12">
        <div class="card card-custom h-100 p-3">
            <div class="card-body text-center">
                <h5 class="fw-bold text-navy mb-2">Soy Compañía</h5>
                <p class="text-muted small mb-4">Gestiona tu perfil, vacantes y contratos seguros.</p>
                <button @onclick="IrACompaniaLogin" class="btn btn-gold w-100 py-2 fw-bold">
                    Ingresar a mi perfil
                </button>
            </div>
        </div>
    </div>
</div>
</div>

@code {
    private void IrATrabajadorLogin() => Navigation.NavigateTo("/login-trabajador");
    private void IrACompaniaLogin() => Navigation.NavigateTo("/login-compania");
}
