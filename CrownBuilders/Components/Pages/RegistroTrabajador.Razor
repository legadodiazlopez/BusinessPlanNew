@page "/registro-trabajador"
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ApiService ApiService
@using System.Net.Http.Json
@using CrownBuilders.Models
@using CrownBuilders.Services
@using System.Text.RegularExpressions

<style>
    :root {
        --navy: #0A192F;
        --gold: #C5A059;
    }
    .text-navy { color: var(--navy); }
    .btn-gold { 
        background-color: var(--navy); 
        color: white; 
        border: 2px solid var(--gold); 
    }
    .card-custom { 
        border: 2px solid var(--gold); 
        border-radius: 15px; 
    }
    .btn-relumbrante {
        color: #007bff;
        font-weight: bold;
        text-shadow: 0 0 8px rgba(0, 123, 255, 0.6);
        border: none;
        background: none;
        text-decoration: underline;
        padding: 0;
        margin-left: 5px;
    }
    .btn-relumbrante:hover {
        color: #0056b3;
    }
</style>

<div class="container mt-4 mb-5">
    <div class="card p-4 shadow-sm card-custom">
        <h4 class="text-center text-navy fw-bold mb-4">Registro de Trabajador</h4>

        @if (!string.IsNullOrEmpty(mensajeError)) {
            <div class="alert alert-danger p-2 small">@mensajeError</div>
        }

        @if (cargando)
        {
            <div class="text-center mb-3">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Cargando...</span>
                </div>
                <p class="text-muted mt-2">Procesando registro...</p>
            </div>
        }

        <div class="text-center mb-3">
            <label for="fileInput" style="cursor: pointer;">
                <div style="width: 110px; height: 110px; background-color: #f8f9fa; border-radius: 50%; margin: 0 auto; display: flex; align-items: center; justify-content: center; border: 2px dashed var(--gold); overflow: hidden; position: relative;">
                    @if (!string.IsNullOrEmpty(fotoPerfilBase64))
                    {
                        <img src="@fotoPerfilBase64" alt="Previsualización" style="width: 100%; height: 100%; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="text-center text-muted">
                            <i class="oi oi-camera fs-4 d-block mb-1"></i>
                            <span class="small" style="font-size: 0.75rem;">Subir Foto</span>
                        </div>
                    }
                </div>
            </label>
            <InputFile id="fileInput" OnChange="CargarFoto" accept="image/*" style="display: none;" disabled="@cargando" />
        </div>

        <div class="mb-2"><label>Nombre Completo</label><input class="form-control" @bind="nombre" disabled="@cargando" /></div>
        <div class="mb-2"><label>Oficio</label><input class="form-control" @bind="oficio" disabled="@cargando" /></div>
        <div class="mb-2"><label>Ciudad</label><input class="form-control" @bind="ciudad" disabled="@cargando" /></div>
        <div class="mb-2"><label>Teléfono</label><input class="form-control" @bind="telefono" type="number" placeholder="Solo números" disabled="@cargando" /></div>
        <div class="mb-2"><label>Correo Electrónico</label><input class="form-control" @bind="correo" type="email" placeholder="correo@dominio.com" disabled="@cargando" /></div>
        <div class="mb-2"><label>Contraseña</label><input class="form-control" @bind="password" type="password" disabled="@cargando" /></div>
        <div class="mb-2"><label>Experiencia (años)</label><input class="form-control" @bind="experiencia" type="number" disabled="@cargando" /></div>
        <div class="mb-2"><label>Salario Esperado ($)</label><input class="form-control" @bind="salario" type="number" disabled="@cargando" /></div>
        
        <div class="mb-2 mt-2">
            <input type="checkbox" @bind="tieneVehiculo" disabled="@cargando" id="chkVehiculo" /> <label for="chkVehiculo">Tiene Vehículo</label>
        </div>
        <div class="mb-2">
            <input type="checkbox" @bind="tieneHerramientas" disabled="@cargando" id="chkHerramientas" /> <label for="chkHerramientas">Tiene Herramientas</label>
        </div>
        
        <div class="form-check mb-3 d-flex align-items-center ps-0">
            <input type="checkbox" class="form-check-input me-2" @bind="aceptaTerminos" disabled="@cargando" id="chkTerminosTrabajador" />
            <button type="button" class="btn-relumbrante" @onclick="MostrarTerminos" disabled="@cargando">
                Acepto los Términos y Políticas de Privacidad
            </button>
        </div>

        <button class="btn btn-gold w-100" @onclick="IniciarRegistro" disabled="@cargando">
            @if (cargando)
            {
                <span class="spinner-border spinner-border-sm" role="status"></span>
                <span>Registrando...</span>
            }
            else
            {
                <span>Registrarse</span>
            }
        </button>
    </div>

    <!-- Modal de verificación -->
    @if (mostrandoVerificacion)
    {
        <div class="modal show d-block" tabindex="-1" style="background:rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content p-3" style="border-radius: 15px;">
                    <div class="modal-header border-0">
                        <h5 class="modal-title fw-bold">Verificación por SMS</h5>
                        <button type="button" class="btn-close" @onclick="() => mostrandoVerificacion = false"></button>
                    </div>
                    <div class="modal-body">
                        <p class="small text-muted">Ingresa el código de 6 dígitos enviado a tu teléfono (por defecto usa 123456 en pruebas):</p>
                        <input class="form-control text-center fs-4" @bind="codigoIngresado" placeholder="123456" maxlength="6" disabled="@cargando" />
                        @if (!string.IsNullOrEmpty(mensajeError)) {
                            <div class="alert alert-danger mt-2 p-1 small">@mensajeError</div>
                        }
                    </div>
                    <div class="modal-footer border-0">
                        @if (cargando)
                        {
                            <button type="button" class="btn btn-gold w-100" disabled>
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                Validando...
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-gold w-100" @onclick="VerificarCodigo">
                                Validar Código
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Modal de Términos y Condiciones -->
    @if (mostrandoTerminos)
    {
        <div class="modal-overlay" style="position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); display:flex; align-items:center; justify-content:center; z-index:1000;">
            <div class="card p-4 shadow" style="width: 90%; max-height: 85vh; overflow-y: auto; border-radius: 15px;">
                <h5 class="fw-bold text-center mb-3">Políticas de Privacidad y Términos</h5>
                <div style="font-size: 0.85em; line-height: 1.5; color: #333;">
                    <h6 class="fw-bold mt-3">TÉRMINOS DE USO Y PRIVACIDAD DE CROWN BUILDERS</h6>
                <ul class="list-unstyled">
                    <li class="mb-2"><b>1. PRIVACIDAD:</b> Tus datos son sagrados. Nunca serán vendidos, compartidos ni comercializados.</li>
                    <li class="mb-2"><b>2. SEGURIDAD:</b> Toda tu actividad está protegida con cifrado de nivel bancario.</li>
                    <li class="mb-2"><b>3. CONEXIÓN:</b> Crown Builders es una herramienta tecnológica para conectar personas. No somos parte de los acuerdos, contratos o pagos realizados entre usuarios.</li>
                    <li class="mb-2"><b>4. RESPONSABILIDAD:</b> Trabajamos constantemente para validar perfiles y asegurar una comunidad de confianza.</li>
                    <li class="mb-2"><b>5. EDAD:</b> Al registrarte, confirmas ser mayor de 18 años.</li>
                    <li class="mb-2"><b>6. TRANSPARENCIA:</b> Sin letras pequeñas.</li>
                    <li class="mb-2"><b>7. PAGOS Y CANCELACIONES:</b> Tu facturación es mensual basada en tu fecha de registro. No realizamos reembolsos.</li>
                    <li class="mb-2"><b> CROWN BUILDERS DEVOLVIENDO LA CORONA A LA CLASE QUE LA MERECE</b></li>
                </ul>
                </div>
                <button class="btn btn-gold w-100 mt-3" @onclick="() => mostrandoTerminos = false">Cerrar</button>
            </div>
        </div>
    }
</div>

@code {
    private bool mostrandoVerificacion = false;
    private bool mostrandoTerminos = false;
    private bool cargando = false;
    private string codigoIngresado = "123456";
    private string codigoGenerado = "123456";
    private string mensajeError = string.Empty;
    private string nombre, oficio, ciudad, correo, password, fotoPerfilBase64;
    private int? experiencia;
    private long? telefono;
    private decimal? salario;
    private bool tieneVehiculo, tieneHerramientas, aceptaTerminos;

    private async Task IniciarRegistro() 
    {
        mensajeError = string.Empty;

        if (string.IsNullOrWhiteSpace(nombre) || !telefono.HasValue || 
            string.IsNullOrWhiteSpace(correo) || string.IsNullOrWhiteSpace(password) || string.IsNullOrWhiteSpace(ciudad))
        {
            mensajeError = "Por favor, completa todos los campos obligatorios (Nombre, Ciudad, Teléfono, Correo, Contraseña).";
            return;
        }

        if (!EsCorreoValido(correo))
        {
            mensajeError = "El formato del correo electrónico no es válido.";
            return;
        }

        if (!aceptaTerminos)
        {
            mensajeError = "Debes aceptar los términos y condiciones para continuar.";
            return;
        }

        cargando = true;
        StateHasChanged();

        try
        {
            var correoExiste = await ApiService.VerificarCorreoExistenteAsync(correo.Trim().ToLower());

            if (correoExiste)
            {
                cargando = false;
                mensajeError = "Este correo electrónico ya está registrado en el sistema.";
                return;
            }

            codigoGenerado = "123456";
            string mensajeSms = $"Tu codigo de verificacion de Crown Builders es: {codigoGenerado}";
            string numeroCompleto = $"+1{telefono.Value}";

            string codigoRecibido = await ApiService.EnviarSmsAsync(numeroCompleto, mensajeSms);
            
            if (!string.IsNullOrEmpty(codigoRecibido))
            {
                codigoGenerado = codigoRecibido;
            }

            codigoIngresado = "123456"; // Autocompletar por defecto para pruebas
            mostrandoVerificacion = true;
        }
        catch (Exception ex)
        {
            mensajeError = "Error al conectar con el servidor: " + ex.Message;
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private async Task VerificarCodigo()
    {
        mensajeError = string.Empty;

        string inputLimpio = codigoIngresado?.Trim() ?? "";
        bool codigoValido = (inputLimpio == codigoGenerado) || (inputLimpio == "123456");

        if (!codigoValido) 
        { 
            mensajeError = "Código incorrecto. En modo pruebas usa: 123456";
            StateHasChanged();
            return;
        }

        if (!telefono.HasValue)
        {
            mensajeError = "El número de teléfono es obligatorio.";
            StateHasChanged();
            return; 
        }

        cargando = true;
        StateHasChanged();

        await Task.Yield(); // Cede un ciclo al hilo principal para evitar congelamiento visual en Android

        try
        {
            var nuevoTrabajador = new CrownBuilders.Trabajador {
                Nombre = nombre, 
                Ciudad = ciudad, 
                Correo = correo.Trim().ToLower(), 
                Password = password, 
                Experiencia = experiencia ?? 0, 
                Telefono = telefono.Value.ToString(), 
                TieneVehiculo = tieneVehiculo, 
                TieneHerramientas = tieneHerramientas,
                Oficio = oficio,
                Salario = (int)(salario ?? 0),
                FotoPerfil = !string.IsNullOrEmpty(fotoPerfilBase64) ? fotoPerfilBase64 : "default",
                EstaDisponible = true
            };
            
            var resultadoAPI = await Task.Run(() => ApiService.RegistrarTrabajador(nuevoTrabajador));

            if (resultadoAPI != null && resultadoAPI.Exitoso)
            {
                nuevoTrabajador.Id = resultadoAPI.Id;
                
                try
                {
                    await DatabaseHelper.GuardarTrabajadorAsync(nuevoTrabajador);
                }
                catch (Exception dbEx)
                {
                    System.Diagnostics.Debug.WriteLine($"Error en base local SQLite: {dbEx.Message}");
                }

                var sesionNueva = await ApiService.LoginTrabajadorAsync(
                    nuevoTrabajador.Correo,
                    nuevoTrabajador.Password);

                if (sesionNueva?.Exitoso != true
                    || string.IsNullOrWhiteSpace(sesionNueva.Token)
                    || sesionNueva.Id != resultadoAPI.Id)
                {
                    mensajeError = "La cuenta se creó, pero no se pudo iniciar sesión automáticamente. Inicia sesión con la nueva cuenta.";
                    mostrandoVerificacion = false;
                    cargando = false;
                    Navigation.NavigateTo("/login-trabajador");
                    return;
                }
                
                mostrandoVerificacion = false;
                cargando = false;
                StateHasChanged();

                await JS.InvokeVoidAsync("alert", "¡Registro exitoso! Cuenta creada en la nube.");
                Navigation.NavigateTo("/companias-disponibles");
            }
            else
            {
                mensajeError = resultadoAPI?.Mensaje ?? "Error al registrar en Azure";
                cargando = false;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            mensajeError = "Error de conexión con Azure: " + ex.Message;
            cargando = false;
            StateHasChanged();
        }
    }

    private async Task CargarFoto(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file != null)
            {
                // Soporte hasta 15MB para fotos de alta resolución tomadas por cámaras de teléfonos
                using var stream = file.OpenReadStream(maxAllowedSize: 1024 * 1024 * 15);
                using var ms = new System.IO.MemoryStream();
                await stream.CopyToAsync(ms);
                var bytes = ms.ToArray();
                
                string contentType = string.IsNullOrWhiteSpace(file.ContentType) ? "image/jpeg" : file.ContentType;
                fotoPerfilBase64 = $"data:{contentType};base64,{Convert.ToBase64String(bytes)}";
                
                mensajeError = string.Empty;
                StateHasChanged(); // Forzar refresco inmediato del componente para mostrar la vista previa en el círculo
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error cargando foto: {ex.Message}");
            mensajeError = "No se pudo cargar la imagen. Intenta seleccionar otra foto más liviana.";
            StateHasChanged();
        }
    }

    private bool EsCorreoValido(string email)
    {
        if (string.IsNullOrWhiteSpace(email)) return false;
        try
        {
            return Regex.IsMatch(email, @"^[^@\s]+@[^@\s]+\.[^@\s]+$", RegexOptions.IgnoreCase);
        }
        catch
        {
            return false;
        }
    }
    
    private void MostrarTerminos() => mostrandoTerminos = true;
}
