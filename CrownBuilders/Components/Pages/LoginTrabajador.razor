@page "/login-trabajador"
@using CrownBuilders.Services
@using CrownBuilders
@inject NavigationManager Navigation
@inject ApiService ApiService

<div class="container mt-4 cb-page cb-page-narrow">
    <div class="mb-3">
        <button @onclick="VolverAlHome" class="btn btn-cb-secondary" disabled="@cargando">
            <i class="oi oi-arrow-left"></i> Volver
        </button>
    </div>

    <div class="row justify-content-center">
        <div class="col-12">
            <div class="card cb-form-card p-4">
                <div class="text-center mb-4">
                    <h3 class="fw-bold text-navy">Acceso Trabajador</h3>
                    <p class="text-muted">Ingresa a tu perfil profesional</p>
                </div>

                @if (!string.IsNullOrEmpty(mensajeError))
                {
                    <div class="alert alert-danger" style="font-size: 0.85em; padding: 10px; margin-bottom: 15px;">
                        @mensajeError
                    </div>
                }

                @if (cargando)
                {
                    <div class="text-center mb-3">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Cargando...</span>
                        </div>
                        <p class="text-muted mt-2">Verificando credenciales...</p>
                    </div>
                }

                <div class="mb-3">
                    <label class="form-label text-navy fw-bold">Correo electrónico</label>
                    <input type="email" class="form-control" @bind="email" placeholder="nombre@ejemplo.com" disabled="@cargando" />
                </div>

                <div class="mb-3">
                    <label class="form-label text-navy fw-bold">Contraseña</label>
                    <input type="password" class="form-control" @bind="password" disabled="@cargando" />
                </div>

                <button class="btn btn-cb-primary w-100 mt-3" @onclick="HandleLogin" disabled="@cargando">
                    @if (cargando)
                    {
                        <span class="spinner-border spinner-border-sm" role="status"></span>
                        <span class="ms-2">Ingresando...</span>
                    }
                    else
                    {
                        <span>Ingresar</span>
                    }
                </button>

                <!-- Bloque de soporte consistente -->
                <div class="text-center mt-3">
                    <a href="https://wa.me/16314860524?text=Hola,%20necesito%20ayuda%20con%20mi%20cuenta%20de%20trabajador%20en%20Crown%20Builders"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="cb-muted-link">
                        ¿Necesitas ayuda con tu acceso?
                    </a>
                </div>

                <div class="text-center mt-4 p-2" style="border-top: 1px solid #dee2e6;">
                    <span class="text-muted">¿No tienes cuenta?</span>
                    <a href="registro-trabajador" class="fw-bold text-gold d-block mt-2 text-decoration-underline">
                        Crear cuenta de trabajador
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string email = "";
    private string password = "";
    private string mensajeError = "";
    private bool cargando = false;

    private void VolverAlHome() => Navigation.NavigateTo("/");

    private async Task HandleLogin()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(password))
            {
                mensajeError = "Por favor, ingresa tu correo y contraseña.";
                return;
            }

            string emailLimpio = email.Trim().ToLower();
            mensajeError = "";
            cargando = true;

            System.Diagnostics.Debug.WriteLine($"[LOGIN] Intentando entrar con -> Correo: '{emailLimpio}'");

            // 1. Intentar autenticación con Azure
            var authResponse = await ApiService.LoginTrabajadorAsync(emailLimpio, password);
            
            if (authResponse != null && authResponse.Exitoso)
            {
                System.Diagnostics.Debug.WriteLine($"[LOGIN] Autenticación exitosa con Azure. ID: {authResponse.Id}");
                
                if (!string.IsNullOrEmpty(authResponse.Token))
                {
                    ApiService.SetAuthToken(authResponse.Token);
                }

                // 2. Ejecución Paralela: Sincronización Local + Token FCM
                // En lugar de esperar a que termine uno para empezar el otro, los lanzamos al mismo tiempo.
                var syncLocalTask = Task.Run(async () => 
                {
                    try
                    {
                        var trabajadorDesdeAzure = await ApiService.ObtenerTrabajadorAsync(authResponse.Id);
                        if (trabajadorDesdeAzure != null)
                        {
                            var trabajadorLocal = new CrownBuilders.Trabajador
                            {
                                Id = trabajadorDesdeAzure.Id,
                                Nombre = trabajadorDesdeAzure.Nombre,
                                Oficio = trabajadorDesdeAzure.Oficio,
                                Ciudad = trabajadorDesdeAzure.Ciudad,
                                Experiencia = trabajadorDesdeAzure.Experiencia,
                                Correo = trabajadorDesdeAzure.Correo,
                                Telefono = trabajadorDesdeAzure.Telefono,
                                Password = trabajadorDesdeAzure.Password,
                                TieneVehiculo = trabajadorDesdeAzure.TieneVehiculo,
                                TieneHerramientas = trabajadorDesdeAzure.TieneHerramientas,
                                EstaDisponible = trabajadorDesdeAzure.EstaDisponible
                            };
                            await DatabaseHelper.GuardarTrabajadorAsync(trabajadorLocal);
                        }
                    }
                    catch (Exception ex)
                    {
                        System.Diagnostics.Debug.WriteLine($"[LOGIN] Error sync local: {ex.Message}");
                    }
                });

                var fcmTask = Task.Run(async () => 
                {
                    try
                    {
                        string fcmToken = await PushNotificationHandler.GetDeviceFcmTokenAsync();
                        if (!string.IsNullOrEmpty(fcmToken))
                        {
                            await PushNotificationHandler.SendFcmTokenAsync(authResponse.Id, fcmToken, "trabajador");
                        }
                    }
                    catch (Exception exFcm)
                    {
                        System.Diagnostics.Debug.WriteLine($"[FCM] Error capturando token: {exFcm.Message}");
                    }
                });

                // Esperamos a que ambas tareas terminen antes de redirigir
                await Task.WhenAll(syncLocalTask, fcmTask);

                mensajeError = "";
                
                // 3. Iniciar precarga en segundo plano de datos (Fire-and-forget)
                BackgroundCacheService.StartBackgroundPreload();
                
                Navigation.NavigateTo("/companias-disponibles");
            }
            else
            {
                System.Diagnostics.Debug.WriteLine($"[LOGIN] Autenticación fallida: {authResponse?.Mensaje}");
                mensajeError = authResponse?.Mensaje ?? "El correo o la contraseña son incorrectos.";
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"[LOGIN] Error: {ex.Message}");
            mensajeError = "Error de conexión: No se pudo conectar al servidor.";
        }
        finally
        {
            cargando = false;
        }
    }
}
