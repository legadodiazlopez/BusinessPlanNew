@page "/mensajeria-compania"
@page "/mensajeria-compania/{NombreTrabajadorRoute}"
@page "/mensajeria-compania/{NombreTrabajadorRoute}/{TrabajadorIdRoute}"
@using Microsoft.Extensions.Logging
@implements IAsyncDisposable
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ILogger<Mensajeriacompania> Logger
@inject CrownBuilders.Services.ApiService ApiService
@inject CrownBuilders.Services.MessagingService MessagingService

<div class="container-fluid d-flex flex-column" style="height: 100vh; background-color: #f8f9fa;">
    <!-- ENCABEZADO MEJORADO: BOTONES DE VOLVER, RESEÑA COMPACTA Y REPORTAR DESTACADO -->
    <div class="bg-white p-3 shadow-sm d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center">
            <button class="btn btn-sm btn-link text-dark p-0 me-2" @onclick="Volver" style="text-decoration: none;">← Volver</button>
            <h5 class="fw-bold mb-0 ms-2" style="color: #0A1128;">Chat con @nombreTrabajador</h5>
        </div>
        <div class="d-flex align-items-center gap-2">
            <!-- Diseño profesional y discreto para "Próximamente" -->
            <div class="bg-light text-secondary px-2 py-1" style="font-size: 0.65rem; border: 1px solid #dee2e6; border-radius: 12px; opacity: 0.8; user-select: none;">
                ⭐ Reseñas <span class="fst-italic">Próximamente</span>
            </div>
            <!-- Botón de reportar más visible -->
            <button class="btn btn-sm btn-danger fw-bold px-3 shadow-sm" style="font-size: 0.8rem; border-radius: 12px;" @onclick="ReportarCuenta">
                Reportar
            </button>
        </div>
    </div>

    <!-- ÁREA DE MENSAJES -->
    <div class="flex-grow-1 p-3 overflow-auto">
        @foreach (var msg in messages)
        {
            <div class="d-flex mb-3 @(msg.EsMio ? "justify-content-end" : "justify-content-start")">
                <div class="p-2 px-3 shadow-sm @(msg.EsMio ? "bg-warning text-dark" : "bg-white text-dark")" style="border-radius: 15px; max-width: 80%;">
                    <span class="fw-bold d-block mb-1" style="font-size: 0.75rem; opacity: 0.8;">
                        @(msg.EsMio ? "Tú" : msg.Remitente)
                    </span>
                    <p class="mb-0 small">@msg.Texto</p>
                </div>
            </div>
        }
    </div>

    <!-- ENTRADA DE TEXTO -->
    <div class="bg-white p-3 shadow-lg">
        <div class="small text-muted mb-2">
            Estado: @(chatConectado ? "Conectado en tiempo real" : estadoChat)
        </div>
        <div class="input-group">
            <input type="text" class="form-control" placeholder="Escribe un mensaje..." @bind="mensajeNuevo" @bind:event="oninput" @onkeyup="HandleKeyUp" />
            <button class="btn text-white fw-bold" style="background-color: #D4AF37;" disabled="@(!chatConectado)" @onclick="EnviarMensaje">Enviar</button>
        </div>
    </div>
</div>

@code {
    [Parameter] public string? NombreTrabajadorRoute { get; set; }
    [Parameter] public string? TrabajadorIdRoute { get; set; }
    
    private List<MensajeUI> messages = new List<MensajeUI>();
    private string? mensajeNuevo;
    
    private string nombreTrabajador = "Trabajador";
    private int companiaIdActual;
    private int trabajadorIdSimulado;
    private int conversationId;
    private bool chatConectado;
    private bool chatInicioIntentado;
    private string estadoChat = "Conectando...";

    public class MensajeUI
    {
        public string ClientMessageId { get; set; } = "";
        public string Remitente { get; set; } = "";
        public string Texto { get; set; } = "";
        public bool EsMio { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        messages.Clear();
        await ApiService.RestoreAuthTokenAsync();

        if (!string.IsNullOrEmpty(NombreTrabajadorRoute))
        {
            nombreTrabajador = Uri.UnescapeDataString(NombreTrabajadorRoute);
        }

        if (!string.IsNullOrEmpty(TrabajadorIdRoute) && int.TryParse(TrabajadorIdRoute, out int trabajadorIdFromRoute))
        {
            trabajadorIdSimulado = trabajadorIdFromRoute;
        }

        companiaIdActual = ApiService.AuthenticatedUserId ?? 0;
        System.Diagnostics.Debug.WriteLine(
            $"[CHAT] ID de compañía autenticada: {companiaIdActual}");

        if (companiaIdActual <= 0 || trabajadorIdSimulado <= 0)
        {
            messages.Add(new MensajeUI
            {
                Remitente = "Sistema",
                Texto = "No se pudo identificar a los participantes de esta conversación.",
                EsMio = false
            });
            return;
        }

        try
        {
            var conversation = await ApiService.EnsureConversationAsync(
                trabajadorIdSimulado,
                companiaIdActual);
            conversationId = conversation?.Id ?? 0;
            System.Diagnostics.Debug.WriteLine($"[CHAT] Conversación compañía preparada: {conversationId}");
            if (conversationId > 0)
            {
                MessagingService.MessageReceived += OnMessageReceivedAsync;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "No se pudo preparar la conversación de mensajería.");
        }

        if (conversationId <= 0)
        {
            estadoChat = "No se pudo validar la sesión. Inicia sesión nuevamente.";
        }

        try
        {
            // El orden de los IDs debe coincidir con el método (TrabajadorId, CompaniaId)
            var historialDB = await DatabaseHelper.ObtenerHistorialAsync(trabajadorIdSimulado, companiaIdActual);
            if (historialDB != null)
            {
                foreach (var msj in historialDB)
                {
                    bool esMio = string.Equals(msj.Remitente, "compania", StringComparison.OrdinalIgnoreCase) ||
                                string.Equals(msj.Remitente, "tú", StringComparison.OrdinalIgnoreCase);

                    string remitenteNombre = esMio ? "Tú" : (string.IsNullOrWhiteSpace(msj.Remitente) ? nombreTrabajador : msj.Remitente);

                    messages.Add(new MensajeUI
                    {
                        ClientMessageId = msj.ClientMessageId,
                        Remitente = remitenteNombre,
                        Texto = msj.Texto ?? "",
                        EsMio = esMio
                    });
                }
            }
        }
        catch
        {
            messages.Add(new MensajeUI { Remitente = "Sistema", Texto = "Modo sin conexión cargado.", EsMio = false });
        }


    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (conversationId > 0 && !chatInicioIntentado)
        {
            try
            {
                chatInicioIntentado = true;
                System.Diagnostics.Debug.WriteLine($"[CHAT] Iniciando SignalR compañía para conversación {conversationId}");
                using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(15));
                await MessagingService.StartAsync(conversationId, cts.Token);
                chatConectado = true;
                estadoChat = "Conectado en tiempo real";
                System.Diagnostics.Debug.WriteLine("[CHAT] SignalR compañía conectado");
            }
            catch (Exception ex)
            {
                chatConectado = false;
                estadoChat = "No se pudo conectar. Inicia sesión nuevamente.";
                Logger.LogWarning(ex, "No se pudo conectar al servidor de mensajería.");
            }

            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OnMessageReceivedAsync(MensajeApiResponse message)
    {
        System.Diagnostics.Debug.WriteLine(
            $"[CHAT] Mensaje recibido por compañía: {message.ClientMessageId}");

        try
        {
            await DatabaseHelper.GuardarMensajeRemotoAsync(message).ConfigureAwait(false);
        }
        catch (Exception exception)
        {
            Logger.LogWarning(
                exception,
                "No se pudo guardar el mensaje remoto en la caché local de la compañía.");
        }

        await InvokeAsync(() =>
        {
            if (messages.Any(item => item.ClientMessageId == message.ClientMessageId))
            {
                return;
            }

            messages.Add(new MensajeUI
            {
                ClientMessageId = message.ClientMessageId,
                Remitente = string.Equals(message.Sender, "compania", StringComparison.OrdinalIgnoreCase)
                    ? "Tú"
                    : (string.IsNullOrWhiteSpace(message.Sender) ? nombreTrabajador : message.Sender),
                Texto = message.Text,
                EsMio = string.Equals(message.Sender, "compania", StringComparison.OrdinalIgnoreCase)
            });
            StateHasChanged();
        });
    }
    
    private void Volver() => Navigation.NavigateTo("/portal-compania");

    private async Task ReportarCuenta()
    {
        string numeroWhatsApp = "16314860524";
        string mensaje = Uri.EscapeDataString($"Hola soporte, necesito reportar un inconveniente con el trabajador {nombreTrabajador} a través de la app Crown Builders.");
        string url = $"https://wa.me/{numeroWhatsApp}?text={mensaje}";
        await JS.InvokeVoidAsync("open", url, "_blank");
    }
    
    private async Task EnviarMensaje()
    {
        if (!chatConectado || string.IsNullOrWhiteSpace(mensajeNuevo))
        {
            return;
        }

        if (!string.IsNullOrWhiteSpace(mensajeNuevo))
        {
            var textoAEnviar = mensajeNuevo;
            mensajeNuevo = string.Empty;
            var clientMessageId = Guid.NewGuid().ToString("D");
            var envioRemotoConfirmado = false;

            try
            {
                var msjEnviado = new CrownBuilders.Models.Mensaje
                {
                    ClientMessageId = clientMessageId,
                    ConversacionId = conversationId,
                    TrabajadorId = trabajadorIdSimulado,
                    CompaniaId = companiaIdActual,
                    Remitente = "compania",
                    Texto = textoAEnviar,
                    FechaEnvio = DateTime.UtcNow
                };
                await DatabaseHelper.EncolarMensajeAsync(msjEnviado).ConfigureAwait(false);

                if (conversationId > 0)
                {
                    var response = await MessagingService.SendAsync(
                        conversationId,
                        Guid.Parse(clientMessageId),
                        textoAEnviar).ConfigureAwait(false);
                    envioRemotoConfirmado = true;
                    await DatabaseHelper.MarcarMensajeSincronizadoAsync(
                        clientMessageId,
                        response.Id,
                        response.ConversationId).ConfigureAwait(false);
                }
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine(
                    $"[CHAT] Error en envío de compañía: {ex.GetType().Name}: {ex.Message}");
                Logger?.LogError($"[CHAT COMPAÑÍA] Error guardando mensaje localmente: {ex.Message}");
            }

            if (envioRemotoConfirmado)
            {
                await InvokeAsync(() =>
                {
                    if (messages.Any(item => item.ClientMessageId == clientMessageId))
                    {
                        return;
                    }

                    messages.Add(new MensajeUI
                    {
                        ClientMessageId = clientMessageId,
                        Remitente = "Tú",
                        Texto = textoAEnviar,
                        EsMio = true
                    });
                    StateHasChanged();
                });
            }

        }
    }

    private async Task HandleKeyUp(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await EnviarMensaje();
        }
    }

    public async ValueTask DisposeAsync()
    {
        MessagingService.MessageReceived -= OnMessageReceivedAsync;
        await Task.CompletedTask;
    }
}
