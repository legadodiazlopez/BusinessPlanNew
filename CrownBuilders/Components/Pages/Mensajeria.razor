@page "/mensajeria"
@using Microsoft.AspNetCore.SignalR.Client
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="container-fluid d-flex flex-column" style="height: 100vh; background-color: #f8f9fa;">
    <div class="bg-white p-3 shadow-sm d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center">
            <button class="btn btn-sm btn-link text-dark" @onclick="Volver">← Volver</button>
            <h5 class="fw-bold mb-0 ms-2" style="color: #0A1128;">Chat con Carlos Mendoza</h5>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-sm btn-outline-warning" @onclick="() => mostrarCalificacion = true">⭐</button>
            <button class="btn btn-sm btn-outline-danger" @onclick="() => mostrarReporte = true">⚠️</button>
        </div>
    </div>

    <div class="flex-grow-1 p-3 overflow-auto">
        @foreach (var msg in messages)
        {
            <div class="d-flex mb-3">
                <div class="bg-white p-2 px-3 shadow-sm" style="border-radius: 15px; max-width: 80%;">
                    <p class="mb-0 small">@msg</p>
                </div>
            </div>
        }
    </div>

    <div class="bg-white p-3 shadow-lg">
        <div class="input-group">
            <input type="text" class="form-control" placeholder="Escribe un mensaje..." @bind="mensajeNuevo" />
            <button class="btn text-white fw-bold" style="background-color: #D4AF37;" @onclick="EnviarMensaje">Enviar</button>
        </div>
    </div>
</div>

@if (mostrarCalificacion)
{
    <div class="modal-overlay" style="position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.6); display:flex; align-items:center; justify-content:center; z-index:1000;">
        <div class="card p-4 shadow" style="width: 90%; border-radius: 15px;">
            <h5 class="fw-bold text-navy">Calificar Servicio</h5>
            
            <label class="small fw-bold mt-2">Puntualidad:</label>
            <select class="form-select mb-2" @bind="califPuntualidad">
                <option value="5">⭐⭐⭐⭐⭐</option>
                <option value="4">⭐⭐⭐⭐</option>
                <option value="3">⭐⭐⭐</option>
                <option value="2">⭐⭐</option>
                <option value="1">⭐</option>
            </select>
            
            <label class="small fw-bold">Pagos:</label>
            <select class="form-select mb-2" @bind="califPagos">
                <option value="5">⭐⭐⭐⭐⭐</option>
                <option value="4">⭐⭐⭐⭐</option>
                <option value="3">⭐⭐⭐</option>
                <option value="2">⭐⭐</option>
                <option value="1">⭐</option>
            </select>
            
            <label class="small fw-bold">Trato Humano:</label>
            <select class="form-select mb-3" @bind="califTrato">
                <option value="5">⭐⭐⭐⭐⭐</option>
                <option value="4">⭐⭐⭐⭐</option>
                <option value="3">⭐⭐⭐</option>
                <option value="2">⭐⭐</option>
                <option value="1">⭐</option>
            </select>

            <div class="d-flex gap-2">
                <button class="btn btn-outline-secondary w-50" @onclick="() => mostrarCalificacion = false">Cancelar</button>
                <button class="btn btn-warning w-50 text-white" @onclick="EnviarCalificacion">Enviar</button>
            </div>
        </div>
    </div>
}
@if (mostrarReporte)
{
    <div class="modal-overlay" style="position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.6); display:flex; align-items:center; justify-content:center; z-index:1000;">
        <div class="card p-4 shadow" style="width: 90%; border-radius: 15px;">
            <h5 class="fw-bold text-danger">Reportar Usuario</h5>
            <textarea class="form-control mb-3" rows="3" @bind="descripcionReporte" placeholder="Describe el motivo..."></textarea>
            <div class="d-flex gap-2">
                <button class="btn btn-outline-secondary w-50" @onclick="() => mostrarReporte = false">Cancelar</button>
                <button class="btn btn-danger w-50" @onclick="EnviarReporte">Enviar</button>
            </div>
        </div>
    </div>
}

@code {
    private HubConnection? hubConnection;
    private List<string> messages = new List<string>();
    private string? mensajeNuevo;
    private bool mostrarReporte = false, mostrarCalificacion = false;
    private string descripcionReporte = "";
    private int califPuntualidad = 5, califPagos = 5, califTrato = 5;

    protected override void OnInitialized()
    {
        hubConnection = new HubConnectionBuilder().WithUrl("https://tu-servidor-api.com/chathub").Build();
        hubConnection.On<string, string>("ReceiveMessage", (u, m) => InvokeAsync(() => { messages.Add($"{u}: {m}"); StateHasChanged(); }));
        _ = ConectarAlServidor();
    }

    private async Task ConectarAlServidor() { try { await hubConnection!.StartAsync(); } catch { messages.Add("Sistema: Modo offline."); } }
    private void Volver() => Navigation.NavigateTo("/companias-disponibles");
    private async Task EnviarMensaje() { if (!string.IsNullOrWhiteSpace(mensajeNuevo)) { messages.Add($"Tú: {mensajeNuevo}"); if (hubConnection?.State == HubConnectionState.Connected) await hubConnection.SendAsync("SendMessage", "Compañía", mensajeNuevo); mensajeNuevo = string.Empty; } }
    
    private async Task EnviarCalificacion()
    {
        // Preparado para Azure: await DatabaseHelper.GuardarCalificacionAsync(califPuntualidad, califPagos, califTrato);
        await JS.InvokeVoidAsync("alert", "¡Calificación enviada correctamente!");
        mostrarCalificacion = false;
    }

    private async Task EnviarReporte()
    {
        // Preparado para Azure: await DatabaseHelper.GuardarReporteAsync(descripcionReporte);
        await JS.InvokeVoidAsync("alert", "Reporte enviado. Revisaremos el caso.");
        mostrarReporte = false;
    }
}