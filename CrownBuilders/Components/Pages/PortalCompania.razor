@page "/portal-compania"
@using CrownBuilders
@using CrownBuilders.Services
@using System.Net.Http.Json
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ApiService ApiService
@inject MessagingService MessagingService

<div class="container mt-4 px-3 cb-page">
    <div class="cb-page-toolbar d-flex justify-content-between align-items-center pb-3 mb-3">
        <div>
            <h2 class="fw-bold text-navy mb-1">Portal de Compañía</h2>
            <p class="text-muted small">Administra tu empresa y explora contratistas disponibles</p>
        </div>
        <button class="btn btn-cb-primary fw-bold px-3" @onclick="AlternarVista">
            @(mostrarConfiguracion ? "Ver Trabajadores" : "Configuración")
        </button>
    </div>

    @if (!mostrarConfiguracion)
    {
        <div class="mb-3">
            <div class="input-group shadow-sm cb-search-control">
                <span class="input-group-text bg-white border-end-0 text-muted">🔍</span>
                <input type="text" class="form-control border-start-0 ps-0" placeholder="Buscar por puesto o especialidad..." @bind="textoBusqueda" @bind:event="oninput">
            </div>
        </div>

        @if (estaCargando)
        {
            <div class="text-center my-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Cargando...</span>
                </div>
                <p class="mt-2 text-muted small">Sincronizando directorio de trabajadores...</p>
            </div>
        }
        else
        {
            <div class="lista-trabajadores pb-3">
                @foreach (var trabajador in TrabajadoresFiltrados)
                {
                    <div class="card cb-list-card border-0 shadow-sm mb-3 p-3">
                        <div class="d-flex align-items-center mb-3">
                            
                            <!-- Foto de Perfil -->
                            @if (!string.IsNullOrEmpty(trabajador.FotoPerfil))
                            {
                                <img src="@trabajador.FotoPerfil" alt="Foto de @trabajador.Nombre" class="cb-profile-avatar rounded-circle me-3" />
                            }
                            else
                            {
                                <div class="cb-profile-avatar cb-profile-placeholder rounded-circle me-3 d-flex justify-content-center align-items-center text-white fw-bold">
                                    @(string.IsNullOrWhiteSpace(trabajador.Nombre) ? "?" : trabajador.Nombre.Substring(0, 1).ToUpper())
                                </div>
                            }

                            <!-- Información Principal -->
                            <div class="flex-grow-1">
                                <h6 class="fw-bold text-dark mb-0">@trabajador.Nombre</h6>
                                <div class="d-flex flex-wrap align-items-center mt-1 gap-2">
                                    <span class="badge cb-role-badge small">@trabajador.Oficio</span>
                                    @if (!string.IsNullOrEmpty(trabajador.Ciudad))
                                    {
                                        <span class="small text-muted fw-semibold">📍 @trabajador.Ciudad</span>
                                    }
                                </div>
                                
                                <div class="mt-1">
                                    <span class="badge @(trabajador.EstaDisponible ? "bg-success" : "bg-secondary")">
                                        @(trabajador.EstaDisponible ? "Disponible" : "Ocupado")
                                    </span>
                                </div>
                            </div>

                            <!-- Tarifa -->
                            <div class="text-end align-self-start">
                                <span class="fw-bold text-success cb-price">$@trabajador.Salario <span class="small text-muted fw-normal">/ hr</span></span>
                            </div>
                        </div>

                        <p class="small text-muted mb-2"><strong>Experiencia:</strong> @trabajador.DescripcionExperiencia</p>
                
                        <div class="d-flex gap-2 mb-3">
                            @if (trabajador.TieneVehiculo)
                            {
                                <span class="badge bg-light text-dark border">🚗 Con Carro</span>
                            }
                            @if (trabajador.TieneHerramientas)
                            {
                                <span class="badge bg-light text-dark border">🛠️ Con Herramientas</span>
                            }
                        </div>

                        <button class="btn btn-cb-primary w-100 fw-bold text-white shadow-sm mt-3"
                                @onclick="() => IrAMensajeria(trabajador)">
                            Contratar / Mensajear
                        </button>
                    </div>
                }
            </div>
        }
    }
    else
    {
        <div class="configuracion-panel pb-3">
            <div class="card cb-section-card cb-section-card-navy border-0 shadow-sm p-3 mb-3">
                <h5 class="fw-bold small mb-3 text-navy">Datos de la compañía</h5>
                <p class="form-control-plaintext border-bottom py-1 fw-semibold text-navy">@perfil.NombreEmpresa</p>
                <div class="d-flex justify-content-end mt-2">
                    <button class="btn btn-cb-primary fw-bold text-white" @onclick="IrAEditarPerfil">Editar perfil</button>
                </div>
            </div>
            
            <div class="card cb-section-card cb-section-card-gold border-0 shadow-sm p-3 mb-3">
                <h5 class="fw-bold small mb-0">Garantía de protección</h5>
                <p class="text-muted small mb-3">Protección activa contra ausencias.</p>
                <button class="btn btn-cb-secondary fw-bold" @onclick="IrAReportarAusencia">Reportar ausencia</button>
            </div>

            <div class="card cb-section-card border-0 shadow-sm p-3 mb-3">
                <h5 class="fw-bold small mb-3 text-navy">Cuenta</h5>
                <button class="btn btn-sm fw-bold btn-outline-danger w-100 mb-3" @onclick="EliminarCuentaPermanentemente">
                    Eliminar cuenta permanentemente
                </button>
            
                <h5 class="fw-bold small mb-3 text-navy">Sesión</h5>
                <button class="btn btn-sm fw-bold btn-outline-secondary w-100" @onclick="CerrarSesion">
                    Cerrar sesión
                </button>
            </div>
        </div>
    }
</div>

@code {
    private PerfilCompania perfil = new PerfilCompania();
    private bool mostrarConfiguracion = false;
    private string textoBusqueda = "";
    private bool estaCargando = true;
    
    private List<TrabajadorViewModel> listaTrabajadores = new List<TrabajadorViewModel>();

    // Cliente estático con la validación TLS normal de la plataforma.
    private static readonly HttpClient _httpClient = new HttpClient
    {
        BaseAddress = new Uri(ApiEndpoints.ApiBaseUrl),
        Timeout = TimeSpan.FromSeconds(15)
    };

    protected override void OnInitialized()
    {
        _ = CargarDatosPortalAsync();
    }

    private async Task CargarDatosPortalAsync()
    {
        try
        {
            await ApiService.RestoreAuthTokenAsync();
            var companiaIdActual = ApiService.AuthenticatedUserId ?? 0;
            var perfilTask = Task.Run(() => DatabaseHelper.ObtenerPerfilCompaniaAsync(companiaIdActual));
            var trabajadoresTask = Task.Run(() => DatabaseHelper.ObtenerTrabajadoresAsync());

            await Task.WhenAll(perfilTask, trabajadoresTask);

            var datosPerfil = await perfilTask;
            if (datosPerfil != null) perfil = datosPerfil;

            var trabajadoresDb = await trabajadoresTask;
            if (trabajadoresDb != null && trabajadoresDb.Count > 0)
            {
                listaTrabajadores = trabajadoresDb.Select(t => new TrabajadorViewModel
                {
                    Id = t.Id,
                    FotoPerfil = t.FotoPerfil,
                    Nombre = t.Nombre,
                    Oficio = t.Oficio,
                    Ciudad = t.Ciudad,
                    Salario = t.Salario,
                    DescripcionExperiencia = $"{t.Experiencia} años de experiencia",
                    EstaDisponible = true,
                    TieneVehiculo = t.TieneVehiculo,
                    TieneHerramientas = t.TieneHerramientas
                }).ToList();
            }
            else
            {
                listaTrabajadores = new List<TrabajadorViewModel> {
                    new TrabajadorViewModel { Id = 1, Nombre = "Carlos Mendoza", Oficio = "Carpintero", Salario = 25, DescripcionExperiencia = "5 años en carpintería.", EstaDisponible = false, TieneVehiculo = true, TieneHerramientas = true }
                };
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"[PORTAL COMPAÑÍA] Error de carga: {ex.Message}");
        }
        finally
        {
            estaCargando = false;
            await InvokeAsync(StateHasChanged);
        }

        // Carga de calificaciones secundarias en segundo plano para evitar bloqueos visuales
        _ = Task.Run(CargarCalificacionesEnSegundoPlano);
    }

    private async Task CargarCalificacionesEnSegundoPlano()
    {
        if (listaTrabajadores.Count == 0) return;

        try
        {
            var calificacionesTasks = listaTrabajadores.Select(async trabajador =>
            {
                try
                {
                    using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(5));
                    var response = await _httpClient.GetAsync($"resenas/promedio/{trabajador.Id}/Trabajador", cts.Token);
                    if (response.IsSuccessStatusCode)
                    {
                        var promedio = await response.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
                        if (promedio.ValueKind != System.Text.Json.JsonValueKind.Undefined)
                        {
                            if (promedio.TryGetProperty("promedioCalificacion2", out var p2)) trabajador.CalificacionExperiencia = (int)Math.Round(p2.GetDouble());
                            if (promedio.TryGetProperty("promedioCalificacion1", out var p1)) trabajador.CalificacionPuntualidad = (int)Math.Round(p1.GetDouble());
                            if (promedio.TryGetProperty("promedioCalificacion3", out var p3)) trabajador.CalificacionActitud = (int)Math.Round(p3.GetDouble());
                        }
                    }
                }
                catch
                {
                    // Ignora fallos individuales silenciosamente para no interrumpir
                }
            });

            await Task.WhenAll(calificacionesTasks);
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"[CALIFICACIONES] Error segundo plano: {ex.Message}");
        }
    }

    private IEnumerable<TrabajadorViewModel> TrabajadoresFiltrados => listaTrabajadores
        .Where(t => string.IsNullOrEmpty(textoBusqueda) ||
                    (!string.IsNullOrEmpty(t.Nombre) && t.Nombre.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase)) ||
                    (!string.IsNullOrEmpty(t.Oficio) && t.Oficio.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase)));

    public class TrabajadorViewModel
    {
        public int Id { get; set; }
        public string FotoPerfil { get; set; } = string.Empty;
        public string Nombre { get; set; } = string.Empty;
        public string Oficio { get; set; } = string.Empty;
        public string Ciudad { get; set; } = string.Empty;
        public int Salario { get; set; }
        public string DescripcionExperiencia { get; set; } = string.Empty;
        public bool EstaDisponible { get; set; }
        public bool TieneVehiculo { get; set; }
        public bool TieneHerramientas { get; set; }
        public int CalificacionExperiencia { get; set; } = 5;
        public int CalificacionPuntualidad { get; set; } = 5;
        public int CalificacionActitud { get; set; } = 5;
    }

    private void AlternarVista() => mostrarConfiguracion = !mostrarConfiguracion;
    private void IrAEditarPerfil() => Navigation.NavigateTo("/editar-perfil-compania");
    private void IrAReportarAusencia() => Navigation.NavigateTo("/boton-garantia");
    
    private void IrAMensajeria(TrabajadorViewModel trabajador) => Navigation.NavigateTo($"/mensajeria-compania/{Uri.EscapeDataString(trabajador.Nombre)}/{trabajador.Id}");
    
    private async Task EliminarCuentaPermanentemente()
    {
        bool confirmado = await JS.InvokeAsync<bool>("confirm", "¿ESTÁS SEGURO? Esta acción es irreversible y borrará tu perfil permanentemente.");
        if (confirmado)
        {
            await DatabaseHelper.EliminarPerfilCompaniaAsync(perfil);
            perfil = new PerfilCompania();
            Navigation.NavigateTo("/");
        }
    }

    private async Task CerrarSesion()
    {
        try
        {
            await MessagingService.StopAsync();
        }
        catch (Exception exception)
        {
            System.Diagnostics.Debug.WriteLine($"[AUTH] No se pudo cerrar el chat durante el cierre de sesión: {exception.Message}");
        }
        finally
        {
            await ApiService.SetAuthTokenAsync(null);
            Navigation.NavigateTo("/");
        }
    }
}
