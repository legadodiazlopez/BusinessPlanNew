@page "/portal-compania"
@using CrownBuilders
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="container mt-4 px-3" style="max-height: 100vh; overflow-y: auto;">
    <div class="d-flex justify-content-between align-items-center pb-3 mb-3 border-bottom">
        <div>
            <h2 class="fw-bold mb-1" style="color: #0A1128;">Portal de Compañía</h2>
            <p class="text-muted small">Administra tu empresa y explora contratistas disponibles</p>
        </div>
        <button class="btn btn-sm fw-bold px-3" style="background-color: #0A1128; color: #ffffff; border-radius: 8px;" @onclick="AlternarVista">
            @(mostrarConfiguracion ? "Ver Trabajadores" : "Configuración")
        </button>
    </div>

    @if (!mostrarConfiguracion)
    {
        <div class="mb-3">
            <div class="input-group input-group-sm shadow-sm" style="border-radius: 12px; overflow: hidden;">
                <span class="input-group-text bg-white border-end-0 text-muted">🔍</span>
                <input type="text" class="form-control border-start-0 ps-0" placeholder="Buscar por puesto o especialidad...">
            </div>
        </div>

        <div class="lista-trabajadores" style="padding-bottom: 20px;">
            @* Aquí comienza el bucle de trabajadores *@
            @foreach (var trabajador in listaTrabajadores)
            {
                <div class="card border-0 shadow-sm mb-3 p-3" style="border-radius: 16px; background: #ffffff;">
                    <div class="d-flex align-items-center mb-2">
                        <div class="flex-grow-1">
                            <h6 class="fw-bold text-dark mb-0">@trabajador.Nombre</h6>
                            <span class="badge small" style="background-color: #0A1128; color: #ffffff;">@trabajador.Especialidad</span>
                            
                            <span class="badge ms-2 @(trabajador.EstaDisponible ? "bg-success" : "bg-secondary")">
                                @(trabajador.EstaDisponible ? "Disponible" : "Ocupado")
                            </span>
                        </div>
                        <div class="text-end">
                            <span class="fw-bold text-success small">$@trabajador.Tarifa / hr</span>
                        </div>
                    </div>

                    <p class="small text-muted mb-2"><strong>Experiencia:</strong> @trabajador.DescripcionExperiencia</p>
            
                    <div class="d-flex gap-2 mb-3">
                        @if (trabajador.TieneVehiculo)
                        {
                            <span class="badge bg-light text-dark border">🚗 Con Carro</span>
                        }
                        @if (trabajador.TieneHerramientas)
                        {
                            <span class="badge bg-light text-dark border">🛠️ Con Herramientas</span>
                        }
                    </div>

                    <div class="d-flex align-items-center justify-content-between mb-1">
                        <span class="small fw-bold">Experiencia</span>
                        <div class="text-warning">
                            @for (int i = 0; i < 5; i++)
                            {
                                <span>★</span>
                            }
                        </div>
                    </div>

                    <div class="d-flex align-items-center justify-content-between mb-1">
                        <span class="small fw-bold">Puntualidad</span>
                        <div class="text-warning">
                            @for (int i = 0; i < 4; i++)
                            {
                                <span>★</span>
                            }
                            <span>☆</span>
                        </div>
                    </div>

                    <div class="d-flex align-items-center justify-content-between mb-1">
                        <span class="small fw-bold">Actitud</span>
                        <div class="text-warning">
                            @for (int i = 0; i < 5; i++)
                            {
                                <span>★</span>
                            }
                        </div>
                    </div>

                    <button class="btn btn-sm w-100 fw-bold text-white shadow-sm mt-3"
                            style="background-color: #0A1128; border-radius: 8px; padding: 10px;"
                            @onclick="IrAMensajeria">
                        Contratar / Mensajear
                    </button>
                </div>
            }
        </div>
    }
    else
    {
        <div class="configuracion-panel" style="padding-bottom: 20px;">
            <div class="card border-0 shadow-sm p-3 mb-3" style="border-radius: 16px; background: #ffffff; border-left: 4px solid #0A1128 !important;">
                <h5 class="fw-bold small mb-3" style="color: #0A1128;">DATOS DE LA COMPAÑÍA</h5>
                <p class="form-control-plaintext border-bottom py-1 fw-semibold" style="color: #0A1128;">@perfil.NombreEmpresa</p>
                <div class="d-flex justify-content-end mt-2">
                    <button class="btn btn-sm fw-bold text-white" style="background-color: #0A1128; border-radius: 8px;" @onclick="IrAEditarPerfil">Editar Perfil</button>
                </div>
            </div>
            
            <div class="card border-0 shadow-sm p-3 mb-3" style="border-radius: 16px; background: #ffffff; border-left: 4px solid #D4AF37 !important;">
                <h5 class="fw-bold small mb-0">GARANTÍA DE PROTECCIÓN</h5>
                <p class="text-muted small mb-3">Protección activa contra ausencias.</p>
                <button class="btn btn-sm fw-bold" style="background-color: #f8f9fa; color: #0A1128; border: 1px solid #0A1128; border-radius: 8px;" @onclick="IrAReportarAusencia">Reportar Ausencia</button>
            </div>

            <div class="card border-0 shadow-sm p-3 mb-3" style="border-radius: 16px; background: #ffffff;">
                <h5 class="fw-bold small mb-3" style="color: #0A1128;">ELIMINACION DE LA CUENTA</h5>
                <button class="btn btn-sm fw-bold btn-outline-danger w-100 mb-3" style="border-radius: 8px;" @onclick="EliminarCuentaPermanentemente">
                    Eliminar cuenta permanentemente
                </button>
            
                <h5 class="fw-bold small mb-3" style="color: #0A1128;">SESIÓN</h5>
                <button class="btn btn-sm fw-bold btn-outline-secondary w-100" style="border-radius: 8px;" @onclick="CerrarSesion">
                    Cerrar sesión
                </button>
            </div>
        </div>
    }
</div>

@code {
    private PerfilCompania perfil = new PerfilCompania();
    private bool mostrarConfiguracion = false;
    
    // Lista de trabajadores que alimentará la UI
    private List<TrabajadorViewModel> listaTrabajadores = new List<TrabajadorViewModel> {
        new TrabajadorViewModel { Nombre = "Carlos Mendoza", Especialidad = "Carpintero", Tarifa = 25, DescripcionExperiencia = "5 años en carpintería.", EstaDisponible = false, TieneVehiculo = true, TieneHerramientas = true }
    };

    protected override async Task OnInitializedAsync()
    {
        var datos = await DatabaseHelper.ObtenerPerfilCompaniaAsync();
        if (datos != null) perfil = datos;
    }

    // Modelo sencillo para el ejemplo
    public class TrabajadorViewModel
    {
        public string Nombre { get; set; }
        public string Especialidad { get; set; }
        public double Tarifa { get; set; }
        public string DescripcionExperiencia { get; set; }
        public bool EstaDisponible { get; set; }
        public bool TieneVehiculo { get; set; }
        public bool TieneHerramientas { get; set; }
    }

    private void AlternarVista() => mostrarConfiguracion = !mostrarConfiguracion;
    private void IrAEditarPerfil() => Navigation.NavigateTo("/editar-perfil-compania");
    private void IrAReportarAusencia() => Navigation.NavigateTo("/boton-garantia");
    private void IrAMensajeria() => Navigation.NavigateTo("/mensajeria-trabajador");
    
    private async Task EliminarCuentaPermanentemente()
    {
        bool confirmado = await JS.InvokeAsync<bool>("confirm", "¿ESTÁS SEGURO? Esta acción es irreversible y borrará tu perfil permanentemente.");
        if (confirmado)
        {
            await DatabaseHelper.EliminarPerfilCompaniaAsync(perfil);
            perfil = new PerfilCompania();
            Navigation.NavigateTo("/");
        }
    }

    private void CerrarSesion()
    {
        // Aquí puedes agregar lógica adicional de limpieza de tokens/sesión local si es necesario.
        Navigation.NavigateTo("/");
    }
}