<Project>
  <PropertyGroup>
    <CheckForSufficientXcodeVersion>false</CheckForSufficientXcodeVersion>
    <SkipXcodeVersionCheck>true</SkipXcodeVersionCheck>
    <ValidateXcodeVersion>false</ValidateXcodeVersion>
    <_SdkValidationSkip>true</_SdkValidationSkip>
    <_XcodeVersion>27.0</_XcodeVersion>
    <SelectedXcodeVersion>27.0</SelectedXcodeVersion>
  </PropertyGroup>
</Project>
